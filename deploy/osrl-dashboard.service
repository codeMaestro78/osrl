[Unit]
Description=OS-RL-Agent Streamlit Dashboard
After=network.target
Wants=osrl-collector@%i.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/os-rl-agent
Environment=PYTHONUNBUFFERED=1
Environment=OSRL_DB=/home/%i/os-rl-agent/data/telemetry.db
ExecStart=/home/%i/os-rl-agent/.venv/bin/streamlit run \
    /home/%i/os-rl-agent/osrl/dashboard/app.py \
    --server.port 8501 \
    --server.address 0.0.0.0 \
    --server.headless true \
    --browser.gatherUsageStats false \
    --theme.base dark \
    --theme.primaryColor "#38bdf8" \
    --theme.backgroundColor "#060d1a" \
    --theme.secondaryBackgroundColor "#0a1628" \
    --theme.textColor "#e2e8f0"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
